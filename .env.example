# Postgres superuser (container bootstrap only)
POSTGRES_PASSWORD=postgres

# Least-privilege role passwords
WAREHOUSE_PASSWORD=warehouse
APP_PASSWORD=appsecret

# Anthropic. Copy this file to .env and fill it in -- the backend container
# reads .env directly, so no shell export is needed (and a stale shell
# variable cannot silently override what you put here).
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5
