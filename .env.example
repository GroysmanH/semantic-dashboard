# Postgres superuser (container bootstrap only)
POSTGRES_PASSWORD=postgres

# Least-privilege role passwords
WAREHOUSE_PASSWORD=warehouse
APP_PASSWORD=appsecret

# Ordered raw-SQL migrations run through the admin connection before the
# application pools open. The Docker backend mounts this path read-only.
MIGRATION_DIR=/db/migrations

# Global assistant. Both deployment gates default off. Even when
# CHAT_SEES_DATA is enabled, visible rows require separate browser consent.
CHAT_ENABLED=false
CHAT_SEES_DATA=false
CHAT_MAX_ROWS=2000
CHAT_MAX_CONTEXT_CHARS=60000
CHAT_HISTORY_TURNS=6
CHAT_TRANSIENT_TTL_SECONDS=900
# Normal conversation clear uses this value. Database detachment has a hard
# emergency ceiling of 30 days even if application cleanup is bypassed.
CHAT_TOMBSTONE_DAYS=30

# Copy this file to .env and fill it in -- the backend container reads .env
# directly, so no shell export is needed (and a stale shell variable cannot
# silently override what you put here).

# Which API answers by default: anthropic | gemini | openai | nvidia.
# Per-request override is the provider selector on the card; this is the
# fallback. Only providers with a key set are offered in the UI.
LLM_PROVIDER=anthropic

# Anthropic. Two tiers: the cheap one answers by default, the strong one
# only when the asker ticks "this one is hard".
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5
LLM_MODEL_STRONG=claude-sonnet-5

# Google AI Studio (aistudio.google.com/apikey). Free, but metered at 20
# requests per DAY per model, which is enough to try the app and nowhere
# near enough to run the eval -- see EVAL_PROVIDER below.
GOOGLE_API_KEY=AIza...
# Both tiers are flash on purpose: a free-tier key gets 429 from every
# Gemini pro model. Run `make models` to re-check against your own key.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_STRONG=gemini-3.6-flash

# OpenAI. Strict structured output -- the server rejects a response that
# does not fit the schema.
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5-mini
OPENAI_MODEL_STRONG=gpt-5

# Open-weight models hosted by NVIDIA NIM behind the OpenAI wire protocol,
# free at the time of writing. NIM's schema enforcement varies by model, so
# this provider is asked for JSON and checked here instead.
#
# NIM's catalogue moves, and a retired model keeps appearing in /models
# while quietly never answering -- which is how DeepSeek left. If this
# provider starts timing out, run `make models` and pick two ids that
# actually respond; nothing else here needs to change.
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=minimaxai/minimax-m3
NVIDIA_MODEL_STRONG=moonshotai/kimi-k3

# Which API `make eval` uses unless told otherwise.
# Anthropic, because the free Gemini tier caps at 20 requests/day/model and
# a full sweep is 360 calls. On Haiku the same sweep costs about $0.30.
EVAL_PROVIDER=anthropic
