# Copy to .env and fill in the keys. The backend container reads .env
# directly, so no shell export is needed -- and a stale shell variable
# cannot silently override what you put here.
#
# This file mirrors the deployment it was handed over from: an assistant
# that is on but cannot see rows, and a dashboard scoped to one real
# schema. For a local run against the bundled synthetic warehouse, leave
# PROFILE_URL commented out and set DEFAULT_SCHEMA=ddh with an empty
# VISIBLE_SCHEMAS.
#
# .env is gitignored. Never paste a real key into THIS file.


# --- local Postgres container -----------------------------------------
# Bootstrap superuser, then the two least-privilege roles the app uses.
POSTGRES_PASSWORD=postgres
WAREHOUSE_PASSWORD=warehouse
APP_PASSWORD=appsecret


# --- LLM providers ----------------------------------------------------
# At least one key is required. Only providers with a key set are offered
# in the UI. Per-request override is the selector on the card; this is the
# fallback.
LLM_PROVIDER=anthropic

# Two tiers everywhere: the cheap model answers by default, the strong one
# only when the asker ticks "this one is hard".
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5
LLM_MODEL_STRONG=claude-sonnet-5

# Google AI Studio (aistudio.google.com/apikey). Free, but metered at 20
# requests per DAY per model -- enough to try the app, nowhere near enough
# to run the eval. Both tiers are flash on purpose: a free-tier key gets
# 429 from every Gemini pro model. `make models` re-checks against a key.
GOOGLE_API_KEY=AIza...
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_STRONG=gemini-3.6-flash

# Strict structured output -- the server rejects a response that does not
# fit the schema.
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5-mini
OPENAI_MODEL_STRONG=gpt-5

# Open-weight models hosted by NVIDIA NIM behind the OpenAI wire protocol.
# NIM's schema enforcement varies by model, so this provider is asked for
# JSON and checked here instead. Its catalogue moves, and a retired model
# keeps appearing in /models while quietly never answering -- which is how
# DeepSeek left. If this provider starts timing out, run `make models`,
# pick two ids that actually respond, and change nothing else.
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=minimaxai/minimax-m3
NVIDIA_MODEL_STRONG=moonshotai/kimi-k3


# --- the assistant ----------------------------------------------------
# Two independent gates. CHAT_ENABLED turns the panel on; CHAT_SEES_DATA
# decides whether row values may reach the provider at all, and even when
# it is true the visible rows still require separate browser consent.
#
# Keep CHAT_SEES_DATA=false against confidential data. The assistant still
# builds and edits cards; it just cannot read the numbers. Note that the
# *query* path always sends table names, column names, labels and any
# declared `values:` domains -- by design, and worth saying out loud to
# anyone who asks whether data leaves the building.
CHAT_ENABLED=true
CHAT_SEES_DATA=false


# --- pointing at a real warehouse -------------------------------------
# WAREHOUSE_URL is composed in docker-compose.yml, where `environment:`
# OVERRIDES this file -- so setting WAREHOUSE_URL here does nothing. Set
# PROFILE_URL instead; it feeds the fallback expression there.
#
# Give that DSN a SELECT-only role scoped to the schemas below. The app
# forcing a read-only session is the last line of defence, not the first,
# and it refuses to start if that guarantee is ever lost.
# PROFILE_URL=postgresql://READ_ONLY_USER:PASSWORD@WAREHOUSE_HOST:5432/warehouse

# Which schema new dashboards start on. `ddh` is the bundled synthetic
# warehouse; use it when PROFILE_URL is unset.
DEFAULT_SCHEMA=ddh

# Which schemas this app may show or be pointed at, comma separated.
# Empty means every schema the credential can read -- correct for a
# warehouse built for this app, wrong for a warehouse it was let into.
# The credential this was handed over with reached 25 schemas including
# employee payroll and medical records; the app had business with one.
VISIBLE_SCHEMAS=


# --- optional, defaults shown -----------------------------------------
# Everything below has a working default in backend/app/config.py. Listed
# so the knobs are discoverable, not because they need setting.

# How long any single warehouse query may run.
# WAREHOUSE_STATEMENT_TIMEOUT=30s

# Ordered raw-SQL migrations, run through the admin connection before the
# application pools open. The Docker backend mounts this path read-only.
# MIGRATION_DIR=/db/migrations

# Assistant context budget and retention.
# CHAT_MAX_ROWS=2000
# CHAT_MAX_CONTEXT_CHARS=60000
# CHAT_HISTORY_TURNS=12
# CHAT_TRANSIENT_TTL_SECONDS=900
# Normal conversation clear uses this value. Database detachment has a
# hard emergency ceiling of 30 days even if application cleanup is
# bypassed.
# CHAT_TOMBSTONE_DAYS=30

# Which API `make eval` uses unless told otherwise. Anthropic, because the
# free Gemini tier caps at 20 requests/day/model and a full sweep is 360
# calls. On Haiku the same sweep costs about $0.30.
# EVAL_PROVIDER=anthropic
